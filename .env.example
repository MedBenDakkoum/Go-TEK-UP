# Modèle de configuration : copier ce fichier en « .env » puis remplacer les valeurs.

# ── Base de données (créée par Docker) ───────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=changez-moi
DB_NAME=campus
# Port de la base côté PC (5433 évite le conflit avec un PostgreSQL déjà installé)
DB_PORT=5433
# Utilisé seulement avec « npm run dev » (application lancée hors Docker) : mêmes valeurs, hôte localhost
DATABASE_URL=postgresql://postgres:changez-moi@localhost:5433/campus

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Générer une valeur : openssl rand -hex 32
JWT_SECRET=
# true seulement si le site est servi en HTTPS
COOKIE_SECURE=false

# ── Application ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Domaines autorisés à l'inscription (vide = tous)
ALLOWED_EMAIL_DOMAINS=tek-up.de,tek-up.tn
# false = pas de confirmation d'e-mail à l'inscription
REQUIRE_EMAIL_VERIFICATION=true

# ── Données initiales ────────────────────────────────────────────────────────
# true = comptes de démonstration ; false en production
SEED_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── E-mails (facultatif ; vide = les e-mails s'affichent dans la console) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusConnect <no-reply@campusconnect.local>