# Modèle de configuration : copier ce fichier en « .env » puis remplacer les valeurs.
# Ne jamais committer le fichier .env (il contient des secrets).

# ── Base de données PostgreSQL (conteneur Docker) ───────────────────────────
DB_USER=postgres
DB_PASSWORD=tekdb
DB_NAME=TEK_DB
# Port de la base côté PC (5433 évite le conflit avec un PostgreSQL déjà installé sur 5432)
DB_PORT=5433
# Utilisé par l'application lancée hors Docker (`npm run dev`) : hôte 127.0.0.1 + port publié
DATABASE_URL=postgresql://postgres:tekdb@127.0.0.1:5433/TEK_DB
# Base dédiée aux tests d'intégration (effacée à chaque exécution)
# TEST_DATABASE_URL=postgresql://postgres:tekdb@127.0.0.1:5433/TEK_DB_TEST

# ── Sécurité ────────────────────────────────────────────────────────────────
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# true uniquement si le site est servi en HTTPS
COOKIE_SECURE=false

# ── Application ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# Domaines autorisés à l'inscription, séparés par des virgules (vide = tous)
ALLOWED_EMAIL_DOMAINS=tek-up.de,tek-up.tn,campus.tn,gmail.com
# false = pas de confirmation d'e-mail à l'inscription (pratique en local)
REQUIRE_EMAIL_VERIFICATION=false

# ── Données initiales ───────────────────────────────────────────────────────
# true = comptes de démonstration ; false en production
SEED_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── E-mails (facultatif ; vide = les e-mails s'affichent dans la console) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Go-TEK-UP <no-reply@go-tek-up.local>
